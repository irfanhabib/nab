{
  "name": "@irfanhabib/nab",
  "version": "0.1.1",
  "description": "A feature-complete, LLM-optimized YNAB (You Need A Budget) command-line client with an MCP server.",
  "type": "module",
  "module": "dist/index.js",
  "bin": {
    "nab": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:dist": "bun build --minify --target=bun --outfile dist/index.js src/index.ts",
    "build": "bun build --compile --minify --sourcemap --outfile nab src/index.ts",
    "prepublishOnly": "bun run build:dist"
  },
  "keywords": [
    "ynab",
    "budget",
    "cli",
    "mcp",
    "llm",
    "finance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfanhabib/nab.git"
  },
  "homepage": "https://github.com/irfanhabib/nab#readme",
  "bugs": {
    "url": "https://github.com/irfanhabib/nab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
