{
  "name": "nab",
  "version": "0.1.0",
  "description": "A feature-complete, LLM-optimized YNAB (You Need A Budget) command-line client with an MCP server.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "nab": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --minify --sourcemap --outfile nab src/index.ts"
  },
  "keywords": [
    "ynab",
    "budget",
    "cli",
    "mcp",
    "llm",
    "finance"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
